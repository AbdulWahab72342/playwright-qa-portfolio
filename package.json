{
  "name": "playwright-qa-portfolio",
  "version": "1.0.0",
  "description": "UI and API test automation with Playwright and TypeScript",
  "private": true,
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "test:headed:serial": "playwright test --project=ui --headed --workers=1",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
